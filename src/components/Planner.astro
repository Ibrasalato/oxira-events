---
import events from '../i18n/events.json';
import { x } from '../i18n/extra';
import { N8N, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = x[lang].planner;
const a = x[lang].ar3d;
const rr = x[lang].render;
const SIZES = [9, 18, 36, 54, 72, 100];
const evName = (ev: (typeof events)[number]) => (lang === 'ar' && ev.name_ar ? ev.name_ar : ev.name);
---
<section id="planner" class="planner" aria-labelledby="planner-title">
  <div class="wrap">
    <div class="pl-head">
      <h2 id="planner-title">{p.title}</h2>
      <p>{p.lead}</p>
    </div>

    <div class="pl-grid">
      <form class="pl-form" data-planner>
        <fieldset>
          <legend>{p.size} ({p.sqm})</legend>
          <div class="seg">
            {SIZES.map((s) => (
              <label class="seg-opt">
                <input type="radio" name="size" value={s} checked={s === 36} />
                <span><bdi>{s === 100 ? '100+' : s}</bdi></span>
              </label>
            ))}
          </div>
          <label class="pl-custom">
            <span>{p.sizeCustom}</span>
            <input type="number" name="sizeCustom" min="4" max="2000" inputmode="numeric" dir="ltr" placeholder="—" />
          </label>
        </fieldset>

        <fieldset>
          <legend>{p.type}</legend>
          <div class="types">
            {p.types.map((ty, i) => (
              <label class="type-opt">
                <input type="radio" name="type" value={ty.id} checked={ty.id === 'corner'} />
                <span class="type-card">
                  <svg viewBox="0 0 40 40" aria-hidden="true">
                    <rect x="8" y="8" width="24" height="24" fill="var(--mist)" />
                    {i < 3 && <line x1="8" y1="8" x2="32" y2="8" stroke="var(--navy)" stroke-width="3" />}
                    {i < 2 && <line x1="8" y1="8" x2="8" y2="32" stroke="var(--navy)" stroke-width="3" />}
                    {i < 1 && <line x1="32" y1="8" x2="32" y2="32" stroke="var(--navy)" stroke-width="3" />}
                  </svg>
                  <span class="type-t">{ty.t}</span>
                  <span class="type-d">{ty.d}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend>{p.build}</legend>
          <div class="seg seg-wrap">
            {p.builds.map((b) => (
              <label class="seg-opt">
                <input type="radio" name="build" value={b.id} checked={b.id === 'custom'} />
                <span>{b.t}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend>{p.extras}</legend>
          <div class="checks">
            {p.extrasList.map((ex) => (
              <label class="check">
                <input type="checkbox" name="extras" value={ex.id} />
                <span>{ex.t}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend>{p.look}</legend>
          <div class="look">
            <div class="look-row">
              <span class="look-l" id="wall-l">{p.wall}</span>
              <div class="swatches" role="radiogroup" aria-labelledby="wall-l">
                {p.walls.map((w) => (
                  <label class="sw" title={w.t}>
                    <input type="radio" name="wall" value={w.id} checked={w.id === 'white'} />
                    <span class={`sw-dot sw-${w.id}`}></span>
                    <span class="sw-t">{w.t}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="look-row">
              <span class="look-l" id="floor-l">{p.carpet}</span>
              <div class="swatches" role="radiogroup" aria-labelledby="floor-l">
                {p.carpets.map((w) => (
                  <label class="sw" title={w.t}>
                    <input type="radio" name="carpet" value={w.id} checked={w.id === 'grey'} />
                    <span class={`sw-dot fl-${w.id}`}></span>
                    <span class="sw-t">{w.t}</span>
                  </label>
                ))}
              </div>
            </div>
            <label class="look-row">
              <span class="look-l">{p.accent}</span>
              <span class="accent-pick"><input type="color" name="accent" value="#F5A800" /><span data-accent-hex dir="ltr">#F5A800</span></span>
            </label>
            <div class="look-row look-logo">
              <span class="look-l">{p.logo}</span>
              <div class="logo-up">
                <label class="btn btn-ghost btn-sm logo-btn">
                  <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
                  {p.logoPick}
                </label>
                <span class="logo-thumb" data-logo-thumb hidden></span>
                <button type="button" class="logo-clear" data-logo-clear hidden>{p.logoClear}</button>
              </div>
              <p class="look-hint">{p.logoHint}</p>
            </div>
          </div>
        </fieldset>

        <label class="pl-event">
          <span>{p.event}</span>
          <select name="event">
            <option value="">{p.eventNone}</option>
            {events.map((ev) => <option value={evName(ev)}>{evName(ev)}</option>)}
          </select>
        </label>
      </form>

      <aside class="pl-out" aria-live="polite" data-txt={JSON.stringify({ loading: p.loading, noWebgl: p.noWebgl })}>
        <div class="pl-tabs" role="tablist" aria-label={p.plan}>
          <button type="button" role="tab" data-view="3d" aria-selected="true">{p.view3d}</button>
          <button type="button" role="tab" data-view="2d" aria-selected="false">{p.view2d}</button>
        </div>
        <div class="pl-pane" data-pane="3d">
          <div class="pl-3d" data-stand3d><span class="pl-concept">{p.concept}</span><p class="pl-status" data-stand-status></p></div>
          <div class="pl-3d-bar">
            <span class="pl-drag">{p.drag}</span>
            <span class="pl-3d-actions">
              <button type="button" data-stand-reset>{p.reset}</button>
              <button type="button" data-stand-save>{p.save}</button>
              <button type="button" class="ar-btn" data-stand-ar>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8 20 7.4v9.2L12 21.2 4 16.6V7.4z M4 7.4l8 4.6 8-4.6 M12 12v9.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                {a.open}
              </button>
            </span>
          </div>
        </div>
        <div class="pl-pane pl-draw" data-pane="2d" hidden>
          <svg viewBox="0 0 320 240" data-plan-svg role="img" aria-label={p.plan}></svg>
        </div>
        <div class="pl-sumbox">
          <p class="pl-out-t">{p.summary}</p>
          <p class="pl-sum" data-plan-summary></p>
          <button type="button" class="btn btn-amber" data-plan-apply>{p.apply}</button>
          <button type="button" class="btn btn-ghost pl-render-btn" data-stand-render>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z M19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            {rr.btn}
          </button>
          <p class="pl-note" data-plan-note role="status"></p>
        </div>
      </aside>
    </div>
  </div>
</section>

<dialog class="ar-dialog rr-dialog" data-render-dialog aria-labelledby="rr-title" data-cfg={JSON.stringify({ url: N8N.boothRender, lang, t: rr })}>
  <div class="ar-head">
    <p id="rr-title">{rr.title}</p>
    <button type="button" class="ar-x" data-rr-close aria-label={rr.close}>×</button>
  </div>
  <div class="rr-stage" data-rr-stage><p class="rr-status" data-rr-status>{rr.working}</p></div>
  <p class="rr-note">{rr.note} <span data-rr-left></span></p>
  <div class="rr-foot" data-rr-foot hidden>
    <a class="btn btn-ghost" data-rr-dl download="oxira-events-stand-render.jpg">{rr.download}</a>
    <button type="button" class="btn btn-amber" data-rr-use>{rr.use}</button>
  </div>
</dialog>

<dialog class="ar-dialog" data-ar-dialog aria-labelledby="ar-title" data-txt={JSON.stringify(a)}>
  <div class="ar-head">
    <p id="ar-title">{a.title}</p>
    <button type="button" class="ar-x" data-ar-close aria-label={a.close}>×</button>
  </div>
  <div class="ar-stage" data-ar-stage><p class="ar-status" data-ar-status>{a.loading}</p></div>
  <p class="ar-hint" data-ar-hint></p>
</dialog>

<script is:inline define:vars={{ P: p, lang }}>
(() => {
  const form = document.querySelector('[data-planner]');
  const svg = document.querySelector('[data-plan-svg]');
  const sumEl = document.querySelector('[data-plan-summary]');
  const NS = 'http://www.w3.org/2000/svg';
  const nf = new Intl.NumberFormat(lang === 'ar' ? 'ar-u-nu-latn' : lang);
  let eventDate = '';

  const state = () => {
    const f = new FormData(form);
    const custom = Number(f.get('sizeCustom')) || 0;
    const size = custom >= 4 ? custom : Number(f.get('size'));
    return {
      size, plus: !custom && Number(f.get('size')) === 100,
      type: f.get('type'), build: f.get('build'),
      extras: f.getAll('extras'), event: f.get('event'),
      wall: f.get('wall'), carpet: f.get('carpet'), accent: String(f.get('accent') || '').toUpperCase(),
      logo: !!(form.logo && form.logo.files && form.logo.files.length),
    };
  };
  const dims = (a) => {
    const d = a <= 12 ? 3 : a <= 30 ? Math.min(5, Math.round(Math.sqrt(a))) : a <= 64 ? 6 : a <= 120 ? 8 : 10;
    const w = Math.max(d, Math.round((a / d) * 2) / 2);
    return [w, d];
  };
  const el = (n, a, txt) => { const e = document.createElementNS(NS, n); for (const k in a) e.setAttribute(k, a[k]); if (txt) e.textContent = txt; svg.append(e); return e; };

  const draw = (s) => {
    svg.innerHTML = '';
    const [w, d] = dims(s.size);
    const maxW = 220, maxH = 140, k = Math.min(maxW / w, maxH / d);
    const W = w * k, H = d * k, X = (320 - W) / 2, Y = 30 + (160 - H) / 2;
    const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
    el('rect', { x: 0, y: 0, width: 320, height: 240, fill: css('--paper') });
    el('rect', { x: X, y: Y, width: W, height: H, fill: css('--mist') });
    // closed sides: back always closed except island; sides depending on type
    const open = { row: ['front'], corner: ['front', 'right'], peninsula: ['front', 'right', 'left'], island: ['front', 'right', 'left', 'back'] }[s.type];
    const sides = { back: [X, Y, X + W, Y], front: [X, Y + H, X + W, Y + H], left: [X, Y, X, Y + H], right: [X + W, Y, X + W, Y + H] };
    for (const [name, [x1, y1, x2, y2]] of Object.entries(sides)) {
      const isOpen = open.includes(name);
      el('line', { x1, y1, x2, y2, stroke: isOpen ? css('--amber') : css('--navy'), 'stroke-width': isOpen ? 3 : 7, 'stroke-dasharray': isOpen ? '7 6' : '', 'stroke-linecap': 'square' });
    }
    // aisle labels on open sides
    const lab = { front: [160, Y + H + 22], back: [160, Y - 12], left: [X - 14, Y + H / 2], right: [X + W + 14, Y + H / 2] };
    for (const name of open) {
      const [lx, ly] = lab[name];
      const t = el('text', { x: lx, y: ly, 'text-anchor': 'middle', 'font-size': 11, fill: css('--ink-2'), 'font-family': 'inherit' }, P.aisle);
      if (name === 'left' || name === 'right') t.setAttribute('transform', `rotate(-90 ${lx} ${ly})`);
    }
    // inside: optional meeting room / storage blocks
    let bx = X + 6;
    const block = (label, bw) => {
      el('rect', { x: bx, y: Y + 6, width: bw, height: Math.min(40, H * 0.38), fill: '#fff', stroke: css('--line') });
      el('text', { x: bx + bw / 2, y: Y + 6 + Math.min(40, H * 0.38) / 2 + 4, 'text-anchor': 'middle', 'font-size': 9.5, fill: css('--ink-2'), 'font-family': 'inherit' }, label);
      bx += bw + 6;
    };
    const tx = (id) => P.extrasList.find((e) => e.id === id).t;
    if (s.extras.includes('meeting')) block(tx('meeting'), Math.min(118, W * 0.48));
    if (s.extras.includes('storage')) block(tx('storage'), Math.min(64, W * 0.26));
    if (s.extras.includes('led')) el('rect', { x: X + W - Math.min(70, W * 0.35) - 8, y: Y + 3, width: Math.min(70, W * 0.35), height: 5, fill: css('--blue') });
    if (s.extras.includes('counter')) el('rect', { x: X + W / 2 - 22, y: Y + H - 16, width: 44, height: 9, fill: css('--navy') });
    // dimension label
    el('text', { x: 160, y: 222, 'text-anchor': 'middle', 'font-size': 13, 'font-weight': 600, fill: css('--navy'), 'font-family': 'inherit', direction: 'ltr' }, `${nf.format(w)} × ${nf.format(d)} m  ·  ${nf.format(s.size)}${s.plus ? '+' : ''} m²`);
  };

  const summary = (s) => {
    const ty = P.types.find((t) => t.id === s.type);
    const b = P.builds.find((x) => x.id === s.build).t;
    const ex = s.extras.map((id) => P.extrasList.find((e) => e.id === id).t);
    const parts = [`${P.size}: ${nf.format(s.size)}${s.plus ? '+' : ''} ${P.sqm}`, `${ty.d} (${ty.t})`, b];
    if (ex.length) parts.push(ex.join(lang === 'ar' ? '، ' : ', '));
    const wl = P.walls.find((w) => w.id === s.wall), cp = P.carpets.find((c) => c.id === s.carpet);
    parts.push(`${P.wall}: ${wl ? wl.t : ''}`, `${P.carpet}: ${cp ? cp.t : ''}`, `${P.accent}: ${s.accent}`);
    if (s.logo) parts.push(`${P.logo} ✓`);
    if (s.event) parts.push(`${P.event}: ${s.event}${eventDate ? ' · ' + eventDate : ''}`);
    return parts.join(' — ');
  };

  const update = () => { const s = state(); draw(s); sumEl.textContent = summary(s); };
  const hex = document.querySelector('[data-accent-hex]');
  form.addEventListener('change', (e) => { if (e.target.name === 'logo') update(); });
  form.addEventListener('input', (e) => {
    if (e.target.name === 'accent' && hex) hex.textContent = e.target.value.toUpperCase();
    if (e.target.name === 'size') form.sizeCustom.value = '';
    if (e.target.name === 'event') eventDate = '';
    update();
  });
  update();

  // Calendar → planner
  document.querySelectorAll('[data-plan-event]').forEach((b) => b.addEventListener('click', () => {
    form.event.value = b.dataset.planEvent;
    eventDate = b.dataset.planDate;
    update();
    document.getElementById('planner').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }));

  // Planner → quote form
  document.querySelector('[data-plan-apply]').addEventListener('click', () => {
    const s = state();
    const q = document.querySelector('[data-quote]');
    q.stand_size.value = `${s.size}${s.plus ? '+' : ''}`;
    if (s.event) q.event_name.value = s.event;
    if (eventDate) q.event_date.value = eventDate;
    q.service.selectedIndex = 0;
    const text = summary(s);
    q.details.value = q.details.value.trim() ? q.details.value.trim() + '\n' + text : text;
    window.__standApplied = true;
    document.querySelector('[data-plan-note]').textContent = P.applied + ' ' + P.attached;
    document.getElementById('contact').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    setTimeout(() => q.name.focus({ preventScroll: true }), 500);
  });
})();
</script>

<script>
  import { boot } from '../scripts/stand-boot';
  boot();
</script>

<style>
  .planner { padding-block: clamp(4rem, 9vw, 7rem); background: var(--paper); }
  .pl-head { display: grid; gap: .9rem; max-width: 46rem; }
  .pl-head p { color: var(--ink-2); font-size: 1.05rem; }
  .pl-grid > * { min-width: 0; }
  .pl-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: 2.5rem; align-items: start; }
  .pl-form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { font-weight: 700; font-size: 1rem; margin-bottom: .7rem; padding: 0; }
  .seg { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border: 1px solid var(--line); background: #fff; }
  .seg-wrap { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .seg-opt { position: relative; }
  .seg-opt + .seg-opt { border-inline-start: 1px solid var(--line); }
  .seg-opt input, .type-opt input, .check input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg-opt span { display: grid; place-items: center; min-height: 3rem; padding: .5rem; font-weight: 600; font-size: .95rem; text-align: center; color: var(--ink-2); }
  .seg-opt input:checked + span { background: var(--navy); color: #fff; }
  .seg-opt input:focus-visible + span, .type-opt input:focus-visible + .type-card, .check input:focus-visible + span { outline: 3px solid var(--amber); outline-offset: 2px; }
  .pl-custom { display: inline-flex; align-items: center; gap: .6rem; margin-top: .7rem; font-size: .9rem; color: var(--ink-2); }
  .pl-custom input { width: 7rem; border: 1px solid var(--line); background: #fff; padding: .5rem .6rem; font: inherit; }
  .types { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .6rem; }
  .type-opt { position: relative; }
  .type-card { display: grid; justify-items: center; gap: .2rem; padding: .9rem .5rem; background: #fff; border: 1px solid var(--line); text-align: center; height: 100%; }
  .type-card svg { width: 44px; height: 44px; }
  .type-t { font-weight: 700; font-size: .92rem; }
  .type-d { font-size: .8rem; color: var(--ink-2); }
  .type-opt input:checked + .type-card { border-color: var(--navy); box-shadow: inset 0 0 0 2px var(--navy); }
  .checks { display: flex; flex-wrap: wrap; gap: .5rem; }
  .check { position: relative; }
  .check span { display: inline-block; padding: .55rem .9rem; border: 1px solid var(--line); background: #fff; font-size: .92rem; cursor: pointer; }
  .check input:checked + span { background: var(--blue); border-color: var(--blue-text); color: #fff; }
  .pl-event { display: grid; grid-template-columns: minmax(0, 1fr); gap: .45rem; font-weight: 700; }
  .pl-event select { width: 100%; min-width: 0; font-weight: 400; border: 1px solid var(--line); background: #fff; padding: .7rem .8rem; min-height: 3rem; font: inherit; }
  .pl-out { position: sticky; top: 5.5rem; background: #fff; border: 1px solid var(--line); padding: 1.5rem; display: grid; gap: .9rem; }
  .pl-out-t { font-size: .85rem; font-weight: 700; color: var(--blue-text); }
  .pl-draw svg { width: 100%; height: auto; display: block; }
  .look { display: grid; gap: 1rem; background: #fff; border: 1px solid var(--line); padding: 1rem 1.1rem; }
  .look-row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); align-items: center; gap: .6rem 1rem; }
  .look-l { font-size: .9rem; font-weight: 600; color: var(--ink-2); }
  .swatches { display: flex; flex-wrap: wrap; gap: .5rem; }
  .sw { position: relative; display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .6rem .3rem .35rem; border: 1px solid var(--line); cursor: pointer; font-size: .85rem; }
  .sw input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .sw-dot { width: 1.3rem; height: 1.3rem; box-shadow: inset 0 0 0 1px rgba(10,37,62,.18); flex: none; }
  .sw:has(input:checked) { border-color: var(--navy); box-shadow: inset 0 0 0 1px var(--navy); }
  .sw:has(input:focus-visible) { outline: 3px solid var(--amber); outline-offset: 2px; }
  .sw-white { background: #F3F4F6; } .sw-navy { background: #0F2D4A; } .sw-black { background: #1C1F24; }
  .sw-wood { background: linear-gradient(135deg, #C79A6B, #A57A4F); }
  .fl-grey { background: #8B949F; } .fl-blue { background: #24508F; } .fl-red { background: #A8232C; }
  .fl-wood { background: repeating-linear-gradient(90deg, #B58858 0 6px, #A0744A 6px 7px); }
  .accent-pick { display: inline-flex; align-items: center; gap: .6rem; font-size: .9rem; font-weight: 600; }
  .accent-pick input { width: 2.6rem; height: 2rem; padding: 0; border: 1px solid var(--line); background: #fff; cursor: pointer; }
  .look-logo .look-hint { grid-column: 2; font-size: .8rem; color: var(--ink-2); }
  .logo-up { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
  .logo-btn { position: relative; overflow: hidden; }
  .logo-btn input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .logo-btn:focus-within { outline: 3px solid var(--amber); outline-offset: 2px; }
  .logo-thumb { display: inline-grid; place-items: center; width: 3.2rem; height: 2.2rem; background: var(--mist); border: 1px solid var(--line); }
  .logo-thumb[hidden], .logo-clear[hidden] { display: none; }
  .logo-thumb :global(img) { max-width: 90%; max-height: 90%; }
  .logo-clear { border: 0; background: none; color: var(--blue-text); font: inherit; font-size: .85rem; font-weight: 600; cursor: pointer; text-decoration: underline; }
  .pl-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--line); }
  .pl-tabs button { border: 0; background: none; font: inherit; font-weight: 700; font-size: .9rem; padding: .5rem .9rem; color: var(--ink-2); cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -1px; }
  .pl-tabs button[aria-selected="true"] { color: var(--navy); border-color: var(--amber); }
  .pl-tabs button[hidden] { display: none; }
  .pl-pane[hidden] { display: none; }
  .pl-3d { position: relative; width: 100%; aspect-ratio: 4 / 3; min-height: 0; background: #E9EEF5; overflow: hidden; touch-action: none; contain: strict; }
  /* the canvas is taken out of flow so its pixel buffer can never resize the frame */
  .pl-3d :global(canvas) { position: absolute; inset: 0; display: block; width: 100% !important; height: 100% !important; cursor: grab; }
