---
interface Props { tone?: 'dark' | 'light'; label?: string }
const { tone = 'dark', label = 'Events' } = Astro.props;
const ink = tone === 'dark' ? '#0A253E' : '#FFFFFF';
---
<span class="logo" dir="ltr">
  <svg class="logo-mark" viewBox="0 0 100 100" aria-hidden="true">
    <polygon points="0,0 34.5,0 34.5,66 0,33" fill={ink} />
    <polygon points="66,0 100,0 100,33 34.5,33" fill="#F5A800" />
    <polygon points="66,34 100,66 100,100 66,100" fill={ink} />
    <polygon points="0,66 66,66 34.5,100 0,100" fill="#007DB4" />
  </svg>
  <span class="logo-word" style={`color:${ink}`}>Oxira</span>
  <span class="logo-sub">{label}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; }
  .logo-mark { width: 2rem; height: 2rem; flex: none; }
  .logo-word { font-weight: 700; font-size: 1.5rem; letter-spacing: -.01em; line-height: 1; }
  .logo-sub {
    font-size: .8rem; font-weight: 600; line-height: 1;
    color: #0A253E; background: #F5A800; padding: .3rem .5rem .32rem;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }
</style>
