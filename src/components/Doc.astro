---
// Simple text page shell (privacy, 404): header with logo and language picker, content, footer.
import Logo from './Logo.astro';
import LangPicker from './LangPicker.astro';
import { t, langPath, CONTACT, type Lang } from '../i18n/content';

interface Props { lang: Lang; pickerPath?: string }
const { lang } = Astro.props;
const c = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="top">
  <div class="wrap top-row">
    <a href={`${base}${langPath(lang)}`} aria-label="Oxira Events"><Logo /></a>
    <div class="top-actions">
      <LangPicker lang={lang} />
      <a class="btn btn-amber btn-sm" href={`${base}${langPath(lang)}#contact`}>{c.quote}</a>
    </div>
  </div>
</header>
<main id="main" class="doc">
  <div class="wrap doc-wrap"><slot /></div>
</main>
<footer class="foot">
  <div class="wrap foot-row">
    <Logo tone="light" />
    <p>{c.footer.tag}</p>
    <p><bdi dir="ltr">{CONTACT.email}</bdi> &nbsp;|&nbsp; <bdi dir="ltr">{CONTACT.phone}</bdi></p>
    <p class="rights">© {new Date().getFullYear()} {c.footer.rights}</p>
  </div>
</footer>

<style is:global>
  .doc { padding-block: clamp(3rem, 7vw, 5.5rem); min-height: 60vh; }
  .doc-wrap { max-width: 46rem; }
  .doc h1 { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; }
  .doc .doc-meta { color: var(--ink-2); margin-top: .6rem; font-size: .95rem; }
  .doc h2 { font-size: 1.2rem; margin-top: 2.2rem; }
  .doc p { margin-top: .6rem; line-height: 1.85; }
  .doc .doc-actions { margin-top: 2rem; display: flex; gap: .8rem; flex-wrap: wrap; }
</style>
