---
// Language picker, same languages and flags as oxira.sa.
import { languages, langPath, type Lang } from '../i18n/content';

// `langs` limits the menu to the language versions that exist for this page (service and region pages: ar, en).
interface Props { lang: Lang; langs?: Lang[] }
const { lang, langs } = Astro.props;
const options = langs ? languages.filter((l) => langs.includes(l.code)) : languages;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = languages.find((l) => l.code === lang)!;
// Keep the visitor on the same page when switching language (e.g. /de/privacy/ -> /fr/privacy/).
const rel = Astro.url.pathname.replace(base, '').replace(/^\/(en|de|fr|ru)(?=\/|$)/, '').replace(/^\//, '').replace(/^404.*/, '');
const label: Record<Lang, string> = { ar: 'اللغة', en: 'Language', de: 'Sprache', fr: 'Langue', ru: 'Язык' };
---
<details class="lp">
  <summary aria-label={`${label[lang]}: ${current.name}`}>
    <span class="lp-flag" style={`background-image:url(${base}/flags/${current.flag}.svg)`} aria-hidden="true"></span>
    <span class="lp-name">{current.name}</span>
    <span class="lp-code" aria-hidden="true">{current.code.toUpperCase()}</span>
    <span class="lp-caret" aria-hidden="true"></span>
  </summary>
  <ul class="lp-menu" role="list">
    {options.map((l) => (
      <li>
        <a href={`${base}${langPath(l.code)}${rel}`} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>
          <span class="lp-flag" style={`background-image:url(${base}/flags/${l.flag}.svg)`} aria-hidden="true"></span>
          <span class={l.code !== lang && (l.code === 'ru' || lang === 'ru') ? 'lp-sys' : undefined}>{l.name}</span>
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.lp[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details.lp[open]').forEach((d) => {
      d.open = false;
      d.querySelector('summary')?.focus();
    });
  });
</script>

<style>
  .lp { position: relative; }
  .lp summary {
    list-style: none; display: inline-flex; align-items: center; gap: .5rem; cursor: pointer;
    font-weight: 600; font-size: .92rem; padding: .5rem .7rem; color: var(--ink-2);
    border: 1px solid transparent; user-select: none; white-space: nowrap;
  }
  .lp summary::-webkit-details-marker { display: none; }
  .lp summary:hover, .lp[open] summary { color: var(--navy); border-color: var(--line); background: #fff; }
  .lp-flag { display: inline-block; width: 20px; height: 15px; background: center / cover no-repeat; box-shadow: 0 0 0 1px rgba(10,37,62,.12); flex: none; }
  .lp-code { display: none; }
  .lp-caret { width: .4em; height: .4em; border-bottom: 2px solid currentColor; border-inline-end: 2px solid currentColor; transform: translateY(-2px) rotate(45deg); opacity: .7; }
  .lp[open] .lp-caret { transform: translateY(2px) rotate(-135deg); }
  .lp-menu {
    position: absolute; top: calc(100% + .35rem); inset-inline-end: 0; z-index: 60; min-width: 11rem;
    list-style: none; margin: 0; padding: .35rem; background: #fff; border: 1px solid var(--line);
    box-shadow: 0 18px 40px -12px rgba(6,26,45,.25);
  }
  .lp-menu a {
    display: flex; align-items: center; gap: .7rem; padding: .6rem .75rem;
    text-decoration: none; color: var(--ink); font-weight: 500; font-size: .95rem;
  }
  .lp-menu a:hover { background: var(--paper); }
  .lp-menu a[aria-current] { font-weight: 700; background: var(--mist); }
  .lp-menu a[aria-current]::after {
    content: ''; margin-inline-start: auto; width: .35em; height: .7em;
    border-bottom: 2px solid var(--blue); border-right: 2px solid var(--blue); transform: rotate(45deg);
  }
  @media (max-width: 560px) {
    .lp-name { display: none; }
    .lp-code { display: inline; }
  }
  .lp-sys { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
</style>
