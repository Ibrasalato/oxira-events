---
import Logo from './Logo.astro';
import LangPicker from './LangPicker.astro';
import Calendar from './Calendar.astro';
import Planner from './Planner.astro';
import Booking from './Booking.astro';
import Chat from './Chat.astro';
import FootLinks from './FootLinks.astro';
import { x } from '../i18n/extra';
import { t, WORK, AISLE, CONTACT, N8N, langPath, type Lang } from '../i18n/content';
import { UI, HUB_SLUG, landingLang, landingHref } from '../i18n/landing';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (p: string) => `${base}/img/${p}`;
const aisle = AISLE.map((id) => WORK.find((w) => w.id === id)!);
const FIRST = 12;
// Service cards link to their own pages (Arabic and English only; other languages get the English page).
const SERVICE_PAGES = [['exhibition-stands', 'conference-stages'], ['lighting-sound-led-screens'], ['media-production'], ['printing-acrylic'], ['promotional-giveaways'], []];
const lu = UI[landingLang(lang)];
---
<a class="skip" href="#main">{({ ar: 'تخطَّ إلى المحتوى', en: 'Skip to content', de: 'Zum Inhalt springen', fr: 'Aller au contenu', ru: 'Перейти к содержимому' })[lang]}</a>

<header class="top">
  <div class="wrap top-row">
    <a href={`${base}${langPath(lang)}`} aria-label="Oxira Events"><Logo /></a>
    <nav class="nav" aria-label={c.nav.services}>
      <a href="#services">{c.nav.services}</a>
      <a href="#planner">{x[lang].cta.navPlanner}</a>
      <a href="#work">{c.nav.work}</a>
      <a href="#about">{c.nav.about}</a>
      <a href="#contact">{c.nav.contact}</a>
    </nav>
    <div class="top-actions">
      <LangPicker lang={lang} />
      <a class="btn btn-amber btn-sm" href="#contact">{c.quote}</a>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-title">
        <p class="kicker">{c.hero.kicker}</p>
        <h1 id="hero-title">{c.hero.title}</h1>
      </div>
      <div class="hero-copy">
        <p class="lead">{c.hero.lead}</p>
        <div class="cta-row">
          <a class="btn btn-navy" href="#planner">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8 20 7.4v9.2L12 21.2 4 16.6V7.4z M4 7.4l8 4.6 8-4.6 M12 12v9.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            {x[lang].cta.design3d}
          </a>
          <a class="btn btn-ghost" href="#contact">{c.hero.primary}</a>
        </div>
        <button class="hero-chat" type="button" data-open-chat>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="9" cy="10.5" r="1.1" fill="currentColor"/><circle cx="12" cy="10.5" r="1.1" fill="currentColor"/><circle cx="15" cy="10.5" r="1.1" fill="currentColor"/></svg>
          {x[lang].cta.orChat}
        </button>
      </div>
    </div>

    <div class="aisle" aria-label={c.hero.aisle}>
      <div class="aisle-track">
        {[0, 1].map((dup) => (
          <ul class="aisle-set" aria-hidden={dup === 1 ? 'true' : undefined}>
            {aisle.map((w, i) => (
              <li class="cut">
                <img src={img(`work/${w.id}-s.webp`)} width={w.w} height={w.h} alt={dup === 1 ? '' : (w.brand ? `${c.work.stand}: ${w.brand}` : c.work.stand)} loading={dup === 0 && i < 4 ? 'eager' : 'lazy'} fetchpriority={dup === 0 && i < 3 ? 'high' : undefined} decoding={dup === 0 && i < 3 ? 'sync' : 'async'} />
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div class="floor" aria-hidden="true"></div>
    </div>
  </section>

  <section id="services" class="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="services-head">
        <h2 id="services-title">{c.services.title}</h2>
        <p>{c.services.lead}</p>
      </div>
      <div class="services-grid">
        <figure class="services-photo cut">
          <img src={img('site/crew.webp')} width="830" height="490" alt="" loading="lazy" decoding="async" />
        </figure>
        <ul class="service-list">
          {c.services.items.map((s, i) => (
            <li class={i === 0 ? 'service lead-service' : 'service'}>
              <h3>{SERVICE_PAGES[i]?.[0] ? <a href={`${base}${landingHref(lang, SERVICE_PAGES[i][0])}`}>{s.t}</a> : s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ul>
      </div>
      <p class="services-more"><a class="btn btn-amber" href={`${base}${landingHref(lang, HUB_SLUG)}`} hreflang={landingLang(lang) === lang ? undefined : 'en'}>{lu.homeServices}</a></p>
    </div>
  </section>

  <Planner lang={lang} />

  <section id="work" class="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="work-head">
        <h2 id="work-title">{c.work.title}</h2>
        <p>{c.work.lead}</p>
        <p class="work-count"><strong>{WORK.length}</strong> {c.work.count}</p>
      </div>
      <ul class="gallery" data-gallery>
        {WORK.map((w, i) => (
          <li class={i >= FIRST ? 'g-item is-extra' : 'g-item'} style={`--ar:${w.w}/${w.h}`}>
            <button type="button" class="g-btn" data-index={i} data-full={img(`work/${w.id}-l.webp`)} data-caption={w.brand ?? c.work.stand} aria-label={w.brand ?? c.work.stand}>
              <img src={img(`work/${w.id}-s.webp`)} width={w.w} height={w.h} alt={w.brand ? `${c.work.stand}: ${w.brand}` : c.work.stand} loading="lazy" decoding="async" />
              {w.brand && <span class="g-cap">{w.brand}</span>}
            </button>
          </li>
        ))}
      </ul>
      <div class="work-more">
        <button type="button" class="btn btn-ghost" data-more aria-expanded="false" data-more-label={c.work.more} data-less-label={c.work.less}>{c.work.more}</button>
      </div>
    </div>
  </section>

  <section class="process" aria-labelledby="process-title">
    <div class="wrap">
      <h2 id="process-title">{c.process.title}</h2>
      <ol class="steps">
        {c.process.steps.map((s, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Calendar lang={lang} />

  <section id="about" class="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <figure class="about-photo cut">
        <img src={img('site/team.webp')} width="520" height="760" alt="" loading="lazy" decoding="async" />
      </figure>
      <div class="about-copy">
        <h2 id="about-title">{c.about.title}</h2>
        <p class="about-body">{c.about.body}</p>
        <dl class="mv">
          <div class="mv-item mv-blue">
            <dt>{c.about.missionT}</dt>
            <dd>{c.about.mission}</dd>
          </div>
          <div class="mv-item mv-amber">
            <dt>{c.about.visionT}</dt>
            <dd>{c.about.vision}</dd>
          </div>
        </dl>
        <a class="btn btn-ghost profile-dl" href={`${base}/oxira-events-profile-2026.pdf`} download>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 19h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {x[lang].profile.download} <small>PDF · 4 MB</small>
        </a>
        <p class="parent">{c.about.parent} <a href={CONTACT.main}>{c.about.parentLink}</a></p>
      </div>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <h2 id="contact-title">{c.form.title}</h2>
        <p>{c.form.lead}</p>
        <p class="or">{c.form.or}</p>
        <ul class="direct">
          <li><a href={CONTACT.whatsapp} rel="noopener" target="_blank"><span>{c.form.whatsapp}</span><bdi dir="ltr">{CONTACT.phone}</bdi></a></li>
          <li><a href={`tel:${CONTACT.phoneHref}`}><span>{c.form.phone}</span><bdi dir="ltr">{CONTACT.phone}</bdi></a></li>
          <li><a href={`mailto:${CONTACT.email}`}><span>{c.form.email}</span><bdi dir="ltr">{CONTACT.email}</bdi></a></li>
        </ul>
        <button type="button" class="book-link" data-open-book>{x[lang].book.link}</button>
      </div>

      <div class="contact-forms" id="book">
        <div class="cf-tabs" role="tablist">
          <button type="button" role="tab" aria-selected="true" data-cf="quote">{x[lang].book.tabQuote}</button>
          <button type="button" role="tab" aria-selected="false" data-cf="book">{x[lang].book.tabBook}</button>
        </div>
      <form class="quote cut" data-quote novalidate>
        <div class="f-row">
          <label class="f"><span>{c.form.name} *</span><input name="name" autocomplete="name" required maxlength="120" /></label>
          <label class="f"><span>{c.form.company}</span><input name="company" autocomplete="organization" maxlength="160" /></label>
        </div>
        <div class="f-row">
          <label class="f"><span>{c.form.phone}</span><input name="phone" type="tel" autocomplete="tel" dir="ltr" maxlength="40" /></label>
          <label class="f"><span>{c.form.email}</span><input name="email" type="email" autocomplete="email" dir="ltr" maxlength="160" /></label>
        </div>
        <p class="f-note">{c.form.contactRule}</p>
        <label class="f"><span>{c.form.service}</span>
          <select name="service">
            {c.form.serviceOptions.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <div class="f-row f-row-3">
          <label class="f"><span>{c.form.event}</span><input name="event_name" maxlength="160" /></label>
          <label class="f"><span>{c.form.date}</span><input name="event_date" maxlength="80" /></label>
          <label class="f"><span>{c.form.size}</span><input name="stand_size" inputmode="numeric" maxlength="40" /></label>
        </div>
        <label class="f"><span>{c.form.details} *</span><textarea name="details" rows="4" required maxlength="5000" placeholder={c.form.detailsHint}></textarea></label>
        <label class="hp" aria-hidden="true">Website<input name="company_website" tabindex="-1" autocomplete="off" /></label>
        <div class="f-actions">
          <button class="btn btn-amber" type="submit" data-label={c.form.submit} data-sending={c.form.sending}>{c.form.submit}</button>
          <p class="f-status" role="status" aria-live="polite" data-status></p>
        </div>
      </form>
        <Booking lang={lang} />
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap"><FootLinks lang={lang} /></div>
  <div class="wrap foot-row">
    <Logo tone="light" />
    <p>{c.footer.tag}</p>
    <p><bdi dir="ltr">{CONTACT.email}</bdi> &nbsp;|&nbsp; <bdi dir="ltr">{CONTACT.phone}</bdi></p>
    <a class="foot-link" href={`${base}/oxira-events-profile-2026.pdf`} download>{x[lang].profile.download}</a>
    <a class="foot-link" href={`${base}${langPath(lang)}privacy/`}>{x[lang].privacy.link}</a>
    <p class="rights">© {new Date().getFullYear()} {c.footer.rights}</p>
  </div>
</footer>

<dialog class="lightbox" data-lightbox aria-label={c.work.title}>
  <figure>
    <img alt="" data-lb-img />
    <figcaption data-lb-cap></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-close" data-lb-close aria-label={c.work.close}>×</button>
  <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={c.work.prev}><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <button type="button" class="lb-btn lb-next" data-lb-next aria-label={c.work.next}><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
</dialog>

<Chat lang={lang} />

<script is:inline define:vars={{ lang, N8N, formText: c.form, CONTACT }}>
(() => {
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));

  // Contact: quote / booking tabs
  const cfTabs = $$('[data-cf]');
  const showCf = (v) => {
    cfTabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.cf === v)));
    $('[data-quote]').hidden = v !== 'quote';
    $('[data-book]').hidden = v !== 'book';
  };
  cfTabs.forEach((t) => t.addEventListener('click', () => showCf(t.dataset.cf)));
  $$('[data-open-book]').forEach((b) => b.addEventListener('click', () => { showCf('book'); $('#book').scrollIntoView({ block: 'start' }); }));
  if (location.hash === '#book') showCf('book');

  // Gallery: show more
  const more = $('[data-more]');
  const gallery = $('[data-gallery]');
  more?.addEventListener('click', () => {
    const open = gallery.classList.toggle('show-all');
    more.setAttribute('aria-expanded', String(open));
    more.textContent = open ? more.dataset.lessLabel : more.dataset.moreLabel;
    if (!open) $('#work').scrollIntoView({ block: 'start' });
  });

  // Lightbox
  const lb = $('[data-lightbox]');
  const items = $$('.g-btn');
  let cur = 0;
  const show = (i) => {
    cur = (i + items.length) % items.length;
    const b = items[cur];
    $('[data-lb-img]').src = b.dataset.full;
    $('[data-lb-img]').alt = b.getAttribute('aria-label');
    $('[data-lb-cap]').textContent = b.dataset.caption + '  ·  ' + (cur + 1) + ' / ' + items.length;
  };
  items.forEach((b) => b.addEventListener('click', () => { show(+b.dataset.index); lb.showModal(); }));
  const step = (d) => show(cur + (document.dir === 'rtl' ? -d : d));
  $('[data-lb-close]').addEventListener('click', () => lb.close());
  $('[data-lb-prev]').addEventListener('click', () => step(-1));
  $('[data-lb-next]').addEventListener('click', () => step(1));
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  // Quote form
  const form = $('[data-quote]');
  const status = $('[data-status]');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form).entries());
    if (!String(d.name).trim() || !String(d.details).trim() || (!String(d.phone).trim() && !String(d.email).trim())) {
      status.textContent = formText.missing; status.className = 'f-status is-err'; return;
    }
    const btn = form.querySelector('[type=submit]');
    btn.disabled = true; btn.textContent = btn.dataset.sending; status.textContent = ''; status.className = 'f-status';
    try {
      let design = null;
      if (window.__standApplied && window.__standExport) {
        try { design = await window.__standExport(); } catch { design = null; }
      }
      const payload = { ...d, lang, page: location.pathname };
      if (design) { payload.design = design.config; payload.files = design.files; }
      const r = await fetch(N8N.form, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok || !j.success) throw new Error('fail');
      form.reset();
      window.__standApplied = false;
      status.textContent = formText.ok + ' ' + (j.id ?? '') + '. ' + formText.okTail;
      status.className = 'f-status is-ok';
    } catch {
      status.innerHTML = '';
      status.append(formText.err + ' ');
      const a = document.createElement('a'); a.href = CONTACT.whatsapp; a.textContent = formText.whatsapp; a.target = '_blank'; a.rel = 'noopener';
      status.append(a);
      status.className = 'f-status is-err';
    } finally {
      btn.disabled = false; btn.textContent = btn.dataset.label;
    }
  });

})();
</script>
