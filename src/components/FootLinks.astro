---
// Crawlable footer links to the service and region pages. Those pages exist in Arabic and English only,
// so the German, French and Russian footers link to the English versions.
import { COPY, SERVICES, REGIONS, VENUES, GUIDES, HUB_SLUG, UI, landingLang, landingHref } from '../i18n/landing';
import type { Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = landingLang(lang);
const u = UI[l];
const other = l !== lang;
---
<nav class="foot-nav" aria-label={u.services} lang={other ? 'en' : undefined} dir={other ? 'ltr' : undefined}>
  <div>
    <p class="foot-h"><a href={landingHref(lang, HUB_SLUG)}>{u.footServices}</a></p>
    <ul>{SERVICES.map((p) => <li><a href={landingHref(lang, p.slug)}>{COPY[l][p.slug].name}</a></li>)}</ul>
  </div>
  <div>
    <p class="foot-h">{u.footRegions}</p>
    <ul>{REGIONS.map((p) => <li><a href={landingHref(lang, p.slug)}>{COPY[l][p.slug].name}</a></li>)}</ul>
  </div>
  <div>
    <p class="foot-h">{u.footVenues}</p>
    <ul>{VENUES.map((p) => <li><a href={landingHref(lang, p.slug)}>{COPY[l][p.slug].name}</a></li>)}</ul>
  </div>
  <div>
    <p class="foot-h">{u.footGuides}</p>
    <ul>{GUIDES.map((p) => <li><a href={landingHref(lang, p.slug)}>{COPY[l][p.slug].name}</a></li>)}</ul>
  </div>
</nav>

<style is:global>
  .foot-nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem 2.5rem; padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,.12); }
  .foot-nav .foot-h { color: #fff; font-weight: 600; margin-bottom: .6rem; }
  .foot-nav .foot-h a { color: #fff; text-decoration: none; }
  .foot-nav .foot-h a:hover { color: var(--amber); }
  .foot-nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .foot-nav ul a { color: #9FB3C9; text-decoration: none; }
  .foot-nav ul a:hover { color: #fff; text-decoration: underline; }
  @media (max-width: 960px) { .foot-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .foot-nav { grid-template-columns: 1fr; } }
</style>
