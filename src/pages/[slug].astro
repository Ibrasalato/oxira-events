---
// Arabic service and region pages (/exhibition-stands/, /exhibition-stands-riyadh/, …) and the hub (/services/).
import LandingPage from '../components/LandingPage.astro';
import { PAGES, HUB_SLUG } from '../i18n/landing';

export function getStaticPaths() {
  return [HUB_SLUG, ...PAGES.map((p) => p.slug)].map((slug) => ({ params: { slug } }));
}
---
<LandingPage lang="ar" slug={Astro.params.slug!} />
