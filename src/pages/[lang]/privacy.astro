---
import Base from '../../layouts/Base.astro';
import Doc from '../../components/Doc.astro';
import PrivacyBody from '../../components/PrivacyBody.astro';
import { languages, type Lang } from '../../i18n/content';

export function getStaticPaths() {
  return languages.filter((l) => l.code !== 'ar').map((l) => ({ params: { lang: l.code } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} page="privacy/"><Doc lang={lang}><PrivacyBody lang={lang} /></Doc></Base>
