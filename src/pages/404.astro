---
import Base from '../layouts/Base.astro';
import Doc from '../components/Doc.astro';
import { x } from '../i18n/extra';
const ar = x.ar.notFound;
const en = x.en.notFound;
---
<Base lang="ar" page="404" noindex>
  <Doc lang="ar">
    <h1>{ar.title}</h1>
    <p>{ar.body}</p>
    <div class="doc-actions"><a class="btn btn-navy" href="/">{ar.home}</a></div>
    <div lang="en" dir="ltr" style="margin-top:3rem;border-top:1px solid var(--line);padding-top:2rem">
      <h2>{en.title}</h2>
      <p>{en.body}</p>
      <div class="doc-actions"><a class="btn btn-ghost" href="/en/">{en.home}</a></div>
    </div>
  </Doc>
</Base>
