---
// Arabic case-study pages. Published projects only (drafts too in `npm run dev`).
import ProjectPage from '../../components/ProjectPage.astro';
import { visibleProjects } from '../../i18n/projects';

export function getStaticPaths() {
  return visibleProjects(import.meta.env.DEV).map((p) => ({ params: { slug: p.slug } }));
}
---
<ProjectPage lang="ar" slug={Astro.params.slug!} />
