---
// Same type pairing as oxira.sa: Arabic in Cairo, Latin and Cyrillic in IBM Plex Sans.
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-500.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/arabic-800.css';
import '../styles/global.css';
import { t, languages, langPath, type Lang } from '../i18n/content';
import { x } from '../i18n/extra';

// `langs`: the language versions that exist for this page (hreflang only lists those). Defaults to all.
// `title` / `description` / `ld`: per-page overrides and extra JSON-LD (service and region pages).
interface Props { lang: Lang; page?: string; noindex?: boolean; langs?: Lang[]; title?: string; description?: string; ld?: unknown[] }
const { lang, page = '', noindex = false, langs = languages.map((l) => l.code), ld = [] } = Astro.props;
const c = t[lang];
const site = 'https://events.oxira.sa';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = languages.find((l) => l.code === lang)!;
const title = Astro.props.title ?? (page === 'privacy/' ? `${x[lang].privacy.title} | Oxira Events` : page === '404' ? `${x[lang].notFound.title} | Oxira Events` : c.title);
const clip = (v: string) => (v.length > 158 ? v.slice(0, 155).replace(/\s+\S*$/, '') + '…' : v);
const description = Astro.props.description ?? (page === 'privacy/' ? clip(x[lang].privacy.body[0].p) : c.description);
const url = (l: Lang) => `${site}${langPath(l)}${page === '404' ? '' : page}`;
---
<!doctype html>
<html lang={lang} dir={c.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={url(lang)} />
    {langs.map((code) => <link rel="alternate" hreflang={code} href={url(code)} />)}
    <link rel="alternate" hreflang="x-default" href={url('ar')} />
    <meta name="theme-color" content="#0A253E" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:image" content={`${site}/og-${lang}.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={current.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': `${site}/#org`,
      name: 'Oxira Events',
      url: site,
      email: 'info@oxira.sa',
      telephone: '+966565670776',
      logo: `${site}/favicon.svg`,
      parentOrganization: { '@type': 'Organization', name: 'Oxira', url: 'https://oxira.sa' },
      address: { '@type': 'PostalAddress', streetAddress: '426 Al Sulaymaniyah, Al Urubah Rd.', addressLocality: 'Riyadh', addressCountry: 'SA' },
      areaServed: { '@type': 'Country', name: 'Saudi Arabia' },
      knowsAbout: ['Exhibition stand design', 'Exhibition stand build', 'Conference stage production', 'Event lighting and sound', 'Event printing'],
    })} />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
